{
  "name": "ai-engineering-system",
  "version": "1.0.0",
  "description": "Sistema de engenharia assistida por IA orientado por agentes, com protocolo Jarvis, memoria global, quality gate e validacao por testes em 3 camadas.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "mcp:sequential-thinking": "npx @modelcontextprotocol/server-sequential-thinking",
    "mcp:context7": "npx @upstash/context7-mcp",
    "mcp:github": "mcp-server-github",
    "test:python": "python -m pytest",
    "quality:python": "python scripts/quality_check.py",
    "runtime:check": "python scripts/runtime_check.py",
    "audit:safety": "python scripts/release_safety_audit.py",
    "policy:calibrate": "python scripts/decision_policy_calibration.py --write-policy",
    "agents:leaderboard": "python scripts/agent_leaderboard.py",
    "templates:init": "python scripts/init_client_templates.py",
    "sonar:up": "docker compose --profile tooling up -d sonarqube",
    "sonar:down": "docker compose --profile tooling down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@upstash/context7-mcp": "^2.1.3"
  }
}
